---
import '../styles/site.css';

const repo = 'https://github.com/dbqp01/anyweb';
const stages = [
  {
    label: 'Declarar',
    title: 'Define la operación',
    detail: 'Indica el sitio, la herramienta y los datos que debe devolver.',
    command: 'anyweb init --file declaracion.json',
    rows: [ ['Sitio', 'Tienda de ejemplo'], ['Herramienta', 'product_detail'], ['Entrada', 'product_name'] ],
  },
  {
    label: 'Demostrar',
    title: 'Muestra dos ejemplos',
    detail: 'Repite la operación con dos entradas distintas. Un tercer caso queda reservado para comprobarla.',
    command: 'anyweb explore mark --site <origen> --tool product_detail --role train --input <datos>',
    rows: [ ['Primer ejemplo', 'train'], ['Segundo ejemplo', 'train'], ['Caso reservado', 'eval'] ],
  },
  {
    label: 'Comprobar',
    title: 'Comprueba la receta',
    detail: 'AnyWeb propone una receta y prueba el caso reservado, sin usarlo para inferir parámetros.',
    command: 'anyweb propose --site <origen>',
    rows: [ ['Inferencia', 'train + train'], ['Comprobación', 'eval'], ['Resultado', 'Listo para revisión'] ],
  },
  {
    label: 'Entregar',
    title: 'Revisa y empaqueta',
    detail: 'Revisa la operación y, si la apruebas, genera un servidor MCP para conectarlo a tu cliente.',
    command: 'anyweb package --site <origen>',
    rows: [ ['Revisión', 'Decisión humana'], ['Salida', 'Servidor MCP'], ['Configuración', 'Cliente compatible'] ],
  },
];
const questions = [
  ['¿Funciona con cualquier web?', 'No necesariamente. La operación debe poder demostrarse y comprobarse con las capacidades actuales. Algunos sitios o flujos requieren un conector específico.'],
  ['¿Puede hacer cambios en una cuenta?', 'Los motores genéricos bloquean POST, PUT, PATCH y DELETE. Un GET también puede tener efectos, por lo que es necesario revisar la operación antes de ejecutarla.'],
  ['¿Cómo funciona el inicio de sesión?', 'La persona inicia sesión manualmente en un navegador visible. AnyWeb puede reutilizar el estado guardado sin pedir contraseñas ni códigos como argumentos de la herramienta.'],
  ['¿Necesito instalar un navegador?', 'Para explorar y para las herramientas que se ejecutan en el navegador necesitas Chromium. Las herramientas HTTP empaquetadas no incluyen Playwright.'],
  ['¿Dónde se ejecuta?', 'AnyWeb se ejecuta localmente con Node.js 24. El servidor MCP generado se registra después en un cliente compatible.'],
  ['¿Ya está publicado en npm?', 'Todavía no. Se instala desde una copia del repositorio o desde un paquete local generado a partir de ella.'],
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Enseña una operación en el navegador y conviértela en una herramienta MCP que puedes revisar con AnyWeb." />
  <meta name="theme-color" content="#f6f7f9" />
  <meta property="og:title" content="AnyWeb — Una web, una herramienta" />
  <meta property="og:description" content="De una operación demostrada en el navegador a una herramienta MCP revisable." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=League+Spartan:wght@600;700&display=swap" rel="stylesheet" />
  <title>AnyWeb — Una web, una herramienta</title>
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="site-header wrap">
    <a class="brand" href="#inicio" aria-label="AnyWeb, inicio"><span class="brand-symbol" aria-hidden="true">aw</span><span>anyweb</span></a>
    <nav class="navigation" aria-label="Principal">
      <a href="#recorrido">El recorrido</a>
      <a href="#capacidades">Capacidades</a>
      <a href="#preguntas">Preguntas</a>
    </nav>
    <a class="nav-action" href={repo}>Ver en GitHub <span aria-hidden="true">↗</span></a>
  </header>

  <main id="contenido">
    <section class="hero wrap" id="inicio" aria-labelledby="titulo-principal">
      <div class="hero-copy">
        <h1 id="titulo-principal">Una web.<br />Una herramienta.</h1>
        <p>Enseña una operación en el navegador y conviértela en una herramienta MCP para tu asistente.</p>
        <div class="hero-actions"><a class="button button-primary" href="#recorrido">Ver cómo funciona <span aria-hidden="true">↘</span></a><a class="text-link" href={repo + '#readme'}>Leer la documentación</a></div>
      </div>
      <div class="hero-demo" data-ui aria-label="Ejemplo ilustrativo del recorrido de AnyWeb">
        <div class="demo-head"><div><span class="demo-mark" aria-hidden="true">aw</span><strong>Una operación, de principio a fin</strong></div><span class="demo-mode">Ejemplo interactivo</span></div>
        <div class="demo-body">
          <div class="demo-tablist" role="group" aria-label="Fases del recorrido">
            {stages.map((stage, index) => <button type="button" class:list={['demo-tab', { active: index === 0 }]} data-stage={index} aria-pressed={index === 0 ? 'true' : 'false'}><span class="tab-dot" aria-hidden="true"></span>{stage.label}</button>)}
          </div>
          <div class="demo-content" aria-live="polite">
            {stages.map((stage, index) => <div class="demo-panel" data-panel={index} hidden={index !== 0}>
              <h2>{stage.title}</h2>
              <p>{stage.detail}</p>
              <dl>{stage.rows.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}</dl>
              <pre><code>{stage.command}</code></pre>
            </div>)}
          </div>
        </div>
        <div class="demo-foot"><span>Ejemplo ilustrativo, sin conexión a sitios.</span><button type="button" class="next-stage">Siguiente fase <span aria-hidden="true">→</span></button></div>
      </div>
    </section>

    <section class="intro wrap" aria-labelledby="idea-title">
      <div><h2 id="idea-title">De mostrar a conectar</h2><p class="intro-statement">Una URL es el comienzo. La operación se enseña, se comprueba y se revisa antes de llegar a tu asistente.</p></div>
      <p>AnyWeb es un prototipo local para desarrolladores. El resultado es una herramienta con entradas definidas que consulta el sitio original.</p>
    </section>

    <section class="process-section" id="recorrido" aria-labelledby="recorrido-title">
      <div class="wrap process-head"><h2 id="recorrido-title">Así se construye</h2><p>Un recorrido visible, desde la primera demostración hasta la herramienta que usa tu cliente MCP.</p></div>
      <div class="wrap process-grid">
        <div class="process-anchor" aria-hidden="true"><div class="process-paper"><div class="paper-title">De la web<br />al MCP</div><div class="paper-flow"><span>Demostrar</span><b>↓</b><span>Comprobar</span><b>↓</b><span>Revisar</span></div><div class="paper-bottom">Una operación a la vez</div></div></div>
        <ol class="process-list">
          <li><h3>Declara</h3><p>Describe el sitio, las entradas y el resultado que debe entregar la herramienta.</p></li>
          <li><h3>Demuestra</h3><p>Muestra la operación dos veces con entradas distintas y reserva una tercera para evaluación.</p></li>
          <li><h3>Comprueba</h3><p>Genera una propuesta con los casos de entrenamiento y compruébala con el caso reservado.</p></li>
          <li><h3>Revisa y conecta</h3><p>Inspecciona la herramienta, decide si aprobarla y empaqueta el servidor MCP.</p></li>
        </ol>
      </div>
    </section>

    <section class="capabilities wrap" id="capacidades" aria-labelledby="capacidades-title">
      <div class="section-heading"><h2 id="capacidades-title">Una operación,<br />el camino adecuado</h2><p>Cada sitio tiene su forma de responder. AnyWeb conserva el modo elegido y hace visibles sus límites.</p></div>
      <div class="capability-row"><div><h3>HTTP y HTML</h3><p>Consulta respuestas compatibles, extrae contenido de páginas y descarga documentos.</p></div><div class="snippet snippet-http" data-ui><div class="snippet-title"><span>Consulta compatible</span><span>HTTP</span></div><div class="request-line"><span>GET</span><code>/products?name=...</code></div><div class="response-lines"><span>Respuesta</span><strong>Datos de la página</strong></div></div></div>
      <div class="capability-row"><div><h3>Navegador</h3><p>Reproduce lecturas aprendidas en Chromium cuando el resultado depende de JavaScript.</p></div><div class="snippet snippet-browser" data-ui><div class="snippet-title"><span>Receta de navegador</span><span>Chromium</span></div><ol><li>Abrir la página observada</li><li>Introducir el parámetro</li><li>Extraer el resultado</li></ol></div></div>
      <div class="capability-row"><div><h3>Sesiones y conectores</h3><p>Inicia sesión manualmente cuando haga falta. Temu y WhatsApp cuentan con conectores específicos de lectura.</p></div><div class="snippet snippet-connectors" data-ui><div class="snippet-title"><span>Conectores disponibles</span><span>Solo lectura</span></div><div><strong>Temu</strong><span>Productos y fichas</span></div><div><strong>WhatsApp</strong><span>Conversaciones y mensajes</span></div></div></div>
    </section>

    <section class="boundaries" aria-labelledby="limites-title"><div class="wrap boundaries-grid"><div><h2 id="limites-title">Los límites<br />también importan</h2><a href={repo + '#qué-no-está-resuelto'}>Consultar los límites <span aria-hidden="true">↗</span></a></div><div class="boundary-copy"><p>AnyWeb no descubre por sí solo cualquier operación ni garantiza compatibilidad con todas las webs.</p><p>Los motores genéricos bloquean las escrituras. Un GET también puede tener efectos, por lo que siempre debes revisar qué hace la operación.</p><p>Si el sitio cambia o la sesión caduca, la receta puede necesitar una nueva revisión.</p></div></div></section>

    <section class="faq wrap" id="preguntas" aria-labelledby="preguntas-title"><div><h2 id="preguntas-title">Lo esencial,<br />sin rodeos</h2><p>Detalles útiles antes de empezar.</p></div><div class="faq-list">{questions.map(([question, answer]) => <details name="faq"><summary>{question}<span class="plus" aria-hidden="true"></span></summary><p>{answer}</p></details>)}</div></section>

    <section class="start wrap" id="empezar" aria-labelledby="empezar-title"><div class="start-copy"><h2 id="empezar-title">Pruébalo en local</h2><p>Necesitas Node.js 24, npm y Git. Instala Chromium aparte para explorar y ejecutar recetas de navegador.</p><a class="button button-light" href={repo + '#uso-local'}>Ver la instalación <span aria-hidden="true">↗</span></a></div><div class="start-code"><p>Desde una copia del repositorio</p><pre><code>npm ci
npx playwright install chromium
node src/cli.mjs --help</code></pre><span>El paquete aún no está publicado en npm.</span></div></section>
  </main>
  <footer class="wrap footer"><a class="footer-brand" href="#inicio">anyweb</a><p>De la web a tu asistente.</p><div><a href={repo}>GitHub</a><a href={repo + '#readme'}>Documentación</a><a href="#inicio">Volver arriba</a></div></footer>
  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-stage]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    const next = document.querySelector<HTMLButtonElement>('.next-stage');
    let selected = 0;
    function showStage(index: number) {
      selected = index;
      buttons.forEach((button, i) => {
        button.classList.toggle('active', i === index);
        button.setAttribute('aria-pressed', String(i === index));
      });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      if (next) next.textContent = index === buttons.length - 1 ? 'Volver a empezar →' : 'Siguiente fase →';
    }
    buttons.forEach((button, index) => button.addEventListener('click', () => showStage(index)));
    next?.addEventListener('click', () => showStage((selected + 1) % buttons.length));

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('in-view');
          obs.unobserve(entry.target);
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.process-list li, .capability-row, .boundary-copy p, .faq details').forEach(item => observer.observe(item));
    }
  </script>
</body>
</html>
